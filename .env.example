# Copy this file to .env and fill in your Supabase project values.
# NEVER commit .env — it is listed in .gitignore.
#
# These variables are VITE_ prefixed and therefore exposed to browser code.
# Only the publishable (anon) key should go here.
# NEVER place your service-role key in a VITE_ variable.

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional, dev only: when both are set AND `vite dev` is running (import.meta.env.DEV),
# the app auto-signs-in with these credentials so RequireAuth doesn't gate every route
# behind /login during local iteration. Never read in a production build. Use a
# throwaway account created for local/preview use only — never real user credentials.
VITE_DEV_AUTO_LOGIN_EMAIL=""
VITE_DEV_AUTO_LOGIN_PASSWORD=""
