# Copy this file to .env and fill in your Supabase project values.
# NEVER commit .env — it is listed in .gitignore.
#
# These variables are VITE_ prefixed and therefore exposed to browser code.
# Only the publishable (anon) key should go here.
# NEVER place your service-role key in a VITE_ variable.

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
